+
+    def read_nfc_type2_pages(self, start_page, count):
+        results = []
+        for page in range(start_page, start_page + count, 4):
+            outbuf = [0] * 2
+            inbuf = [0] * 16
+            cmd = Fm175xxCmdMetaData()
+            cmd.send_crc_en = FM175XX_SET
+            cmd.recv_crc_en = FM175XX_SET
+            cmd.send_buff = outbuf
+            cmd.recv_buff = inbuf
+            cmd.send_buff[0] = 0x30
+            cmd.send_buff[1] = page
+            cmd.bytes_to_send = 2
+            cmd.bits_to_send = 0
+            cmd.bits_to_recv = 0
+            cmd.bytes_to_recv = 16
+            cmd.timeout = 10
+            cmd.cmd = FM175XX_CMD_TRANSCEIVE
+            result = self.__command_exe(cmd)
+            if result.err_code != FM175XX_OK or result.out_param.bytes_recved != 16:
+                return FM175XX_CARD_READ_ERR, None
+            results.extend(result.out_param.recv_buff[0:16])
+        return FM175XX_OK, results
     def request_read_card_info(self, channel):
