# Snapmaker Orca lists a loaded spool only when the printer's "<brand> <type> <sub-type>" is exactly
# the name of a filament Orca itself ships, and it ships none for third-party brands, so a spool read
# perfectly off its tag is dropped from Machine Filament with no error at all. On, every
# non-Snapmaker spool is reported as Generic with no sub-type, which Orca does have. Off, the brand
# written on the tag is reported as it is.
[bespok3d_rfid]
force_generic_vendor: $RFID_FORCE_GENERIC_VENDOR

[rfid_ntag]
