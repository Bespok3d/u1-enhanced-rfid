{
  "name": "rfid-ntag",
  "title": "RFID Spool Reader",
  "version": "0.1.3",
  "description": "USB RFID reader picks up OpenSpool-encoded NTAG215 cards. Writes the current spool's metadata to rfid_data.json on every card event so the rest of the stack just knows.",
  "tagline": "NTAG215/OpenSpool RFID: your filament knows what it is.",
  "category": "filament",
  "channel": "lts",
  "printer_specific": true,
  "source": "https://github.com/bespok3d-org/plugin-rfid-ntag",
  "homepage": "https://github.com/bespok3d-org/plugin-rfid-ntag",
  "changelog": "doc/CHANGELOG.md",
  "published_at": "2025-09-02",
  "updated_at": "2026-05-31",
  "publisher": "PLACEHOLDER",
  "provides": [
    {
      "service": "rfid-service"
    }
  ],
  "require": [],
  "conflicts": [],
  "requires": {
    "capabilities": [
      "rfid-spi"
    ],
    "variables": []
  },
  "permissions": [
    "klipper-extra",
    "klipper-config",
    "klipper-source",
    "restart"
  ],
  "install": {
    "place": [
      {
        "class": "klipper-extra",
        "src": "files/rfid-base/extras/bespok3d_rfid.py"
      },
      {
        "class": "klipper-config",
        "src": "files/klipper/rfid.cfg"
      },
      {
        "class": "klipper-extra",
        "src": "files/klipper/klippy/extras/rfid-support/rfid_ntag.py"
      },
      {
        "class": "klipper-extra",
        "src": "files/klipper/klippy/extras/rfid-support/payload_mapper.py"
      },
      {
        "class": "klipper-extra",
        "src": "files/klipper/klippy/extras/rfid-support/chips/ndef_parser.py"
      },
      {
        "class": "klipper-extra",
        "src": "files/klipper/klippy/extras/rfid-support/chips/ntag_reader.py"
      },
      {
        "class": "klipper-extra",
        "src": "files/klipper/klippy/extras/rfid-support/tags/openspool_mapper.py"
      }
    ],
    "instrument": [
      {
        "class": "klipper-source",
        "name": "extras/fm175xx_reader.py",
        "diff": "files/rfid-base/patches/fm175xx_reader-v1.4.246.patch"
      },
      {
        "class": "klipper-source",
        "name": "extras/filament_detect.py",
        "diff": "files/rfid-base/patches/filament_detect-v1.4.246.patch"
      }
    ],
    "restart": [
      "klipper"
    ]
  },
  "conflict_resolutions": [
    {
      "id": "rfid-ntag-old-fw-fm175xx",
      "description": "FW <=1.4.0.38 uses ppins GPIO (not gpiod); different patch context required for fm175xx_reader.py",
      "condition": {
        "adapter": "snapmaker-u1",
        "fw_max": "1.4.0.244"
      },
      "resolution": "files/rfid-base/patches/fm175xx_reader-v1.3.patch"
    },
    {
      "id": "rfid-ntag-old-fw-filament",
      "description": "FW <=1.4.0.38 uses copy.deepcopy; different patch context required for filament_detect.py",
      "condition": {
        "adapter": "snapmaker-u1",
        "fw_max": "1.4.0.244"
      },
      "resolution": "files/rfid-base/patches/filament_detect-v1.3.patch"
    }
  ],
  "files": []
}
